# Copie para .env.local e ajuste. Arquivos .env*.local não vão para o Git.

# Edição do app: "local" (padrão; dados só no navegador) ou "cloud" (ainda não implementada)
VITE_EDITION=local

# Edição Cloud (a partir da F4). Só chaves PÚBLICAS aqui: tudo que começa com VITE_ vai para o navegador.
# Supabase › Project Settings › API Keys (URL em Data API). Nunca coloque a secret key/service_role nem a senha do banco.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
