{
  "name": "gerador-orcamento",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_EDITION=local vite",
    "dev:cloud": "VITE_EDITION=cloud vite",
    "build": "tsc -b && VITE_EDITION=local vite build",
    "build:cloud": "tsc -b && VITE_EDITION=cloud vite build",
    "preview": "vite preview",
    "test": "VITE_EDITION=local vitest run",
    "test:watch": "VITE_EDITION=local vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "mwg": "DISABLE_TELEMETRY=1 modern-web-guidance",
    "mwg:scan": "DISABLE_TELEMETRY=1 modern-web-guidance legacy-scan src",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/editions/cloud/database.types.ts && prettier --write src/editions/cloud/database.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.119.2",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "modern-web-guidance": "1.0.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "license": "AGPL-3.0-only"
}
